# 是否使用离线演示模式。没有真实模型 Key 时设为 true。
MOCK_MODE=true

# 默认源语言与目标语言
DEFAULT_SOURCE_LANG=English
DEFAULT_TARGET_LANG=Chinese

# 模型 A：建议配置为速度快、成本低的模型
MODEL_A_BASE_URL=https://api.openai.com/v1
MODEL_A_API_KEY=
MODEL_A_NAME=gpt-4o-mini
MODEL_A_PRICE_INPUT_PER_1K=0.00015
MODEL_A_PRICE_OUTPUT_PER_1K=0.00060

# 模型 B：建议配置为质量更好的模型或另一个厂商模型
MODEL_B_BASE_URL=https://api.openai.com/v1
MODEL_B_API_KEY=
MODEL_B_NAME=gpt-4.1-mini
MODEL_B_PRICE_INPUT_PER_1K=0.00040
MODEL_B_PRICE_OUTPUT_PER_1K=0.00160

# OCR 配置：Windows 如需指定 tesseract 路径，可填写绝对路径
TESSERACT_CMD=
